# MAPPER Contratos — variáveis de ambiente (nomes apenas, SEM valores reais).
# Copie este arquivo para .env.local e preencha com valores REAIS antes de rodar localmente.
# NUNCA commite .env.local (já está no .gitignore).
#
# IMPORTANTE: este produto (MAPPER Contratos / "full") usa o projeto Supabase "FULL"
# (ref: abhlinzbzinanxzyqtmz, região us-east-2). Isso é DIFERENTE do produto irmão
# "Registro de Oportunidade" (repo separado mapper-registro-oportunidade), que usa o
# projeto Supabase "RO" (ref: hgczpdwhjqaqiravorrg). NÃO troque as credenciais entre os dois —
# um problema conhecido (ver docs/PROBLEMAS_CONHECIDOS.md) é justamente a suspeita de a
# service role key do Worker apontar pro projeto errado.

# --- Supabase (PÚBLICAS, usadas no browser) — projeto FULL ---
NEXT_PUBLIC_SUPABASE_URL=https://abhlinzbzinanxzyqtmz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_publica

# --- Supabase (SECRETAS, apenas no servidor / API routes / scripts) ---
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_SECRETA

# --- Conexão direta ao Postgres do Supabase (usada por scripts server-side) ---
# Settings → Database → Connection string (URI/pooler).
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.abhlinzbzinanxzyqtmz.supabase.co:5432/postgres

# --- Build / deploy (Cloudflare Worker via OpenNext) ---
# Tag padrão usada em vars não-secretas do wrangler.jsonc
ATLAS_DEFAULT_TAG=PRODUCAO
# Token da API da Cloudflare, usado pelos scripts de build/deploy (scripts/build-cf.mjs, deploy-cf.mjs)
CLOUDFLARE_API_TOKEN=
# Timestamp/identificador de build exposto no client (opcional, telas de diagnóstico)
NEXT_PUBLIC_BUILD_STAMP=

# --- Pipeline de coleta (referência) ---
# O motor de coleta/classificação (PNCP + fontes não-PNCP) vive em repositório Python
# SEPARADO (atlas-pncp-pilot), rodando 24/7 em VMs Oracle e escrevendo direto no Supabase FULL.
# Esta variável só é usada por scripts locais de automação/atalho, se você tiver esse repo
# clonado ao lado deste. Não é necessária para rodar o site em si.
ATLAS_PIPELINE_DIR=
